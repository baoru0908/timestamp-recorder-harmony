{
  "app": {
    // ⚠️ signingConfigs 不入库（2026-09-16 起）。
    //    原因：material 里含签名口令（storePassword / keyPassword）与本机真实路径（C:\Users\<用户名>\...），
    //    属敏感信息。签名配置由 DevEco Studio「自动签名」在本地生成，
    //    或自行 File → Project Structure → Signing Configs 配置；hvigor 构建时若缺签名则产出 unsigned 包。
    "products": [
      {
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        },
        "compatibleSdkVersion": "6.0.2(22)",
        "name": "default",
        "runtimeOS": "HarmonyOS",
        "targetSdkVersion": "26.0.0"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}